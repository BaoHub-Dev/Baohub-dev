--[[
    Auto Wall Hop Script (Bảo Hub Custom Edition - FIXED)
    - Intro: "Bảo Hub" text effect on startup
    - UI: Elegant Fonts (GothamBold), Customized names
    - Mode 1: Wall Hop Ngang (Cooldown 0.05s)
    - Mode 2: Wall Hop Dọc (Cooldown 0.3s)
]]

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

-- --- TẠO GUI CHÍNH ---
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "BaoHubWallHopGui"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = PlayerGui

-- --- PHẦN 1: INTRO "BẢO HUB" KHI XUẤT HIỆN ---
local IntroLabel = Instance.new("TextLabel")
IntroLabel.Name = "IntroLabel"
IntroLabel.Size = UDim2.new(0, 400, 0, 100)
IntroLabel.Position = UDim2.new(0.5, -200, 0.5, -50) -- Căn chính giữa màn hình
IntroLabel.BackgroundTransparency = 1
IntroLabel.Text = "Bảo Hub"
IntroLabel.TextColor3 = Color3.fromRGB(0, 255, 150) -- Màu xanh neon phát sáng
IntroLabel.Font = Enum.Font.GothamBold -- Phông chữ đẹp, dày dặn
IntroLabel.TextSize = 60
IntroLabel.TextStrokeTransparency = 0.5
IntroLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
IntroLabel.TextTransparency = 1 -- Ẩn đi lúc đầu để làm hiệu ứng
IntroLabel.Parent = ScreenGui

-- Hiệu ứng Fade In / Fade Out cho Intro
task.spawn(function()
    -- hiện lên (Fade In)
    TweenService:Create(IntroLabel, TweenInfo.new(1), {TextTransparency = 0}):Play()
    task.wait(1.5)
    -- biến mất (Fade Out)
    TweenService:Create(IntroLabel, TweenInfo.new(0.8), {TextTransparency = 1}):Play()
    task.wait(0.8)
    IntroLabel:Destroy()
end)

-- --- PHẦN 2: GIAO DIỆN NÚT BẤM (COMPACT UI) ---
local function createButton(name, text, position)
    local button = Instance.new("TextButton")
    button.Name = name
    button.Size = UDim2.new(0, 150, 0, 38) -- Kích thước vừa vặn cho chữ dài
    button.Position = position
    button.BackgroundColor3 = Color3.fromRGB(25, 25, 25) -- Đen xám nhám sang trọng
    button.Text = text
    button.TextColor3 = Color3.fromRGB(220, 220, 220)
    button.Font = Enum.Font.GothamBold -- Đổi phông chữ nút bấm sang GothamBold cực đẹp
    button.TextSize = 12
    button.ClipsDescendants = true
    button.Parent = ScreenGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8) -- Bo góc mịn
    corner.Parent = button

    -- Tính năng Kéo thả (Drag)
    local dragging, dragStart, startPos
    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = button.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            button.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    return button
end

-- Tạo 2 nút với tên gọi mới theo yêu cầu
local ButtonNgang = createButton("HopNgangButton", "Wall Hop Ngang: OFF", UDim2.new(0, 15, 0.4, 0))
local ButtonDoc = createButton("HopDocButton", "Wall Hop Dọc: OFF", UDim2.new(0, 15, 0.4, 48))

-- Ẩn giao diện chính một chút để nhường chỗ cho Intro tỏa sáng lúc đầu
ButtonNgang.BackgroundTransparency = 1
ButtonNgang.TextTransparency = 1
ButtonDoc.BackgroundTransparency = 1
ButtonDoc.TextTransparency = 1

task.spawn(function()
    task.wait(1.8) -- Chờ intro mờ dần rồi hiện nút ra mượt mà
    TweenService:Create(ButtonNgang, TweenInfo.new(0.5), {BackgroundTransparency = 0, TextTransparency = 0}):Play()
    TweenService:Create(ButtonDoc, TweenInfo.new(0.5), {BackgroundTransparency = 0, TextTransparency = 0}):Play()
end)

-- --- PHẦN 3: LOGIC KHỞI TẠO HỆ THỐNG WALL HOP ---
local isNgangEnabled = false
local isDocEnabled = false
local isFlicking = false
local lastFlickTime = 0
local Camera = workspace.CurrentCamera
local lastJumpedPart = nil 

-- Hàm thực hiện Flick quay góc
local function performWallHop()
    if isFlicking then return end
    isFlicking = true
    
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChild("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then isFlicking = false return end

    hum:ChangeState(Enum.HumanoidStateType.Jumping)
    hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, 50, hrp.AssemblyLinearVelocity.Z)

    local startCFrame = Camera.CFrame
    Camera.CFrame = startCFrame * CFrame.Angles(0, math.rad(180), 0)
    
    task.wait(0.01)
    
    Camera.CFrame = startCFrame
    isFlicking = false
end

-- Hệ thống Quét và Nhận diện Tường
local lastHitInstance = nil
RunService.Heartbeat:Connect(function()
    if not isNgangEnabled and not isDocEnabled then return end
    
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {char}
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude

    local result = workspace:Raycast(hrp.Position, Camera.CFrame.LookVector * 3, raycastParams)

    if result and result.Instance.CanCollide then
        local currentPart = result.Instance

        if lastHitInstance and lastHitInstance ~= currentPart then
            local cooldown = 0.05 -- Cooldown Ngang
            if isDocEnabled then
                cooldown = 0.3 -- Cooldown Dọc đúng 0.3 giây
            end
            
            -- Bắt buộc phải qua khối Part/vạch kẻ mới hoàn toàn
            if currentPart ~= lastJumpedPart and (os.clock() - lastFlickTime > cooldown) then
                lastFlickTime = os.clock()
                lastJumpedPart = currentPart
                performWallHop()
            end
        end
        lastHitInstance = currentPart
    else
        lastHitInstance = nil
        if not result then
            lastJumpedPart = nil
        end
    end
end)

-- --- PHẦN 4: SỰ KIỆN BẬT/TẮT ĐỔI MÀU NÚT BẤM ---
ButtonNgang.MouseButton1Click:Connect(function()
    isNgangEnabled = not isNgangEnabled
    ButtonNgang.Text = isNgangEnabled and "Wall Hop Ngang: ON" or "Wall Hop Ngang: OFF"
    ButtonNgang.BackgroundColor3 = isNgangEnabled and Color3.fromRGB(0, 150, 90) or Color3.fromRGB(25, 25, 25)
    ButtonNgang.TextColor3 = isNgangEnabled and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(220, 220, 220)
    if isNgangEnabled then 
        isDocEnabled = false 
        ButtonDoc.Text = "Wall Hop Dọc: OFF" 
        ButtonDoc.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        ButtonDoc.TextColor3 = Color3.fromRGB(220, 220, 220)
    end
end)

ButtonDoc.MouseButton1Click:Connect(function()
    isDocEnabled = not isDocEnabled
    ButtonDoc.Text = isDocEnabled and "Wall Hop Dọc: ON" or "Wall Hop Dọc: OFF"
    ButtonDoc.BackgroundColor3 = isDocEnabled and Color3.fromRGB(150, 0, 45) or Color3.fromRGB(25, 25, 25)
    ButtonDoc.TextColor3 = isDocEnabled and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(220, 220, 220)
    if isDocEnabled then 
        isNgangEnabled = false 
        ButtonNgang.Text = "Wall Hop Ngang: OFF" 
        ButtonNgang.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        ButtonNgang.TextColor3 = Color3.fromRGB(220, 220, 220)
    end
end)

print("Bảo Hub Auto Wall Hop Loaded!")
